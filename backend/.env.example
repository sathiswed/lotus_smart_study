ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://lotus:lotus@localhost:5432/lotus_smart_study
FRONTEND_ORIGIN=http://localhost:3000

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=lotus_session
SESSION_HOURS=8
COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300

SHORT_ANSWER_MAX_CHARS=4000
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_PAGES=10
IMAGE_MAX_PIXELS=20000000
IMAGE_MAX_DIMENSION=3000
IMAGE_QUALITY=88
TEXTBOOK_MAX_BYTES=104857600

S3_ENDPOINT_URL=https://your-private-s3-compatible-endpoint
S3_REGION=us-east-1
S3_BUCKET=lotus-smart-study-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_SECONDS=900

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Either the API origin or its /v1 base is accepted; the adapter resolves /responses.
OPENAI_BASE_URL=https://api.openai.com
LLM_TIMEOUT_SECONDS=90
# One shared budget for provider failures and generated-output validation.
LLM_GENERATION_RETRIES=2
LLM_MAX_CONTEXT_CHARACTERS=48000
LLM_PROMPT_VERSION=multi-curriculum-v1
LLM_SIMILARITY_THRESHOLD=0.86
